{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "ES2017",
      "dom"
    ],
    "module": "esnext",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "types": [
      "cypress",
      "node"
    ],
    "strict": true,
    "noEmit": true,
    "isolatedModules": false,
    "resolveJsonModule": true,
    "esModuleInterop": true
  },
  "include": [
    "**/*.ts"
  ]
}
